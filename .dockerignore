.git
.gitignore

# Secrets arrive at runtime via env_file. Baking them into a layer would leave
# them extractable from the image forever.
.env
.env.*
!.env.example

__pycache__/
*.py[cod]
.venv/
venv/
env/
ENV/

# Customer exports; also keeps the build context small.
data/
reports/
*.xlsx
*.xlsm
*.xls
*.csv
~$*

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

Dockerfile
.dockerignore
docker-compose.yml
README.md

# The front end is built inside the image (see the `web` stage), so a local
# install and a local build are both dead weight in the context -- and a stale
# dist/ copied in would silently win over the one just built.
node_modules/
dist/
*.tsbuildinfo
